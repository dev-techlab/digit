{
  "name": "octanlink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "node scripts/next-with-env.mjs dev",
    "build": "next build",
    "start": "node scripts/next-with-env.mjs start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "tsc --noEmit && next lint && prettier --check . && next build",
    "fetch:providers": "tsx scripts/fetch-providers.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:mail": "tsx scripts/test-mail.ts",
    "agent:seed": "tsx scripts/seed-agent.ts",
    "db:test": "tsx scripts/test-db.ts",
    "platforms:sync": "tsx scripts/sync-platforms.ts",
    "platforms:seed": "tsx scripts/seed-platforms.ts",
    "icons:localize": "node scripts/localize-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@prisma/adapter-pg": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "next-themes": "^0.4.4",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "swr": "^2.4.2",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.22.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  }
}
